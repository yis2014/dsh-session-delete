# This directory is a scratch workspace for DSH. Only the delivered plugin, its
# market index, the root README, and the verification tooling are tracked.
/*
!/.gitignore
!/README.md
!/market.json
!/session-delete-plugin/
!/session-delete-tools/

# Extracted third-party packages used while validating the market index.
/session-delete-tools/.market/
/session-delete-tools/.extract*/
/session-delete-tools/.base/

# Verification screenshots are kept locally: they contain session titles and
# account UI from the machine that produced them.
/session-delete-tools/*.png

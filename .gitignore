# This directory is a scratch workspace for DSH. The repository is the plugin
# package itself: every root file below is part of the published package.
/*
!/.gitignore
!/README.md
!/market.json
!/package.json
!/index.js
!/client.js
!/cordis.patch.yml
!/icon.svg
!/locale/
!/tools/

# Extracted third-party packages used while validating the market index.
/tools/.*/

# Verification screenshots are kept locally: they contain session titles and
# account UI from the machine that produced them.
/tools/*.png

